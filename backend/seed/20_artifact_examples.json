    {
      "revision_id": "03bb5a7c-b702-5017-a67e-53de473438be",
      "record_id": "075470ea-dd17-5aa3-8eef-50f0b993527b",
      "schema_id": "909c0690-88f4-5b33-b023-2a99f117b721",
      "revision_no": 1,
      "content_json": {
        "artifact_type": "FUNCTIONAL_REQUIREMENT",
        "process": "SYS.2",
        "name": "挟み込み判定",
        "target_element_ref": {
          "record_id": "00000000-0000-4000-8000-000000000012"
        },
        "stakeholder_requirement_refs": [
          {
            "record_id": "00000000-0000-4000-8000-000000000003"
          }
        ],
        "behavior_summary": "電流としきい値から挟み込みを判定する",
        "inputs": [
          {
            "name": "MotorCurrent",
            "interface_spec_ref": {
              "record_id": "00000000-0000-4000-8000-000000000020"
            }
          },
          {
            "name": "CurrentThreshold",
            "data": {
              "name": "CurrentThreshold",
              "data_type": "FLOAT32",
              "unit": "A",
              "initial_value": 8.0
            }
          }
        ],
        "outputs": [
          {
            "name": "PinchDetected",
            "data": {
              "name": "PinchDetected",
              "data_type": "BOOLEAN"
            }
          }
        ],
        "transformations": [
          {
            "output": "PinchDetected",
            "kind": "DECISION_TABLE",
            "decision_table": {
              "hit_policy": "FIRST",
              "rules": [
                {
                  "rule_no": 1,
                  "when": [
                    {
                      "input": "MotorCurrent",
                      "operator": ">=",
                      "value": 8.0
                    }
                  ],
                  "then": [
                    {
                      "output": "PinchDetected",
                      "value": true
                    }
                  ]
                },
                {
                  "rule_no": 2,
                  "when": [
                    {
                      "input": "MotorCurrent",
                      "operator": "BETWEEN",
                      "value": [
                        0,
                        8
                      ]
                    },
                    {
                      "input": "Mode",
                      "operator": "ANY"
                    }
                  ],
                  "then": [
                    {
                      "output": "PinchDetected",
                      "value": false
                    }
                  ]
                }
              ],
              "default_then": [
                {
                  "output": "PinchDetected",
                  "value": false
                }
              ]
            }
          }
        ]
      },
      "change_reason": "examples からの初期投入"
    },
    {
      "revision_id": "7cd036cc-e8df-509e-aaf4-f0573ba2e398",
      "record_id": "1e397db8-4c89-555a-ac65-31d3c5a9144d",
      "schema_id": "909c0690-88f4-5b33-b023-2a99f117b721",
