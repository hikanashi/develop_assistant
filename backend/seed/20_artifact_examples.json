      "content_json": {
        "artifact_type": "FUNCTIONAL_REQUIREMENT",
        "process": "SYS.2",
        "name": "電流換算",
        "target_element_ref": {
          "record_id": "00000000-0000-4000-8000-000000000011"
        },
        "stakeholder_requirement_refs": [
          {
            "record_id": "00000000-0000-4000-8000-000000000003"
          }
        ],
        "behavior_summary": "ADC値を電流に換算する",
        "inputs": [
          {
            "name": "AdcRaw",
            "interface_spec_ref": {
              "record_id": "00000000-0000-4000-8000-000000000020"
            }
          }
        ],
        "outputs": [
          {
            "name": "MotorCurrent",
            "interface_spec_ref": {
              "record_id": "00000000-0000-4000-8000-000000000021"
            }
          }
        ],
        "transformations": [
          {
            "output": "MotorCurrent",
            "kind": "FORMULA",
            "formula": {
              "expression": "MotorCurrent = (AdcRaw - 2048) * 0.01",
              "unit": "A",
              "saturation": {
                "min": 0,
                "max": 30
              }
            }
          }
        ]
      },
