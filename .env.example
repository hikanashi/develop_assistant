# ローカル開発用の環境変数の雛形。値を設定して .env にコピーする:  cp .env.example .env
# .env は Git にコミットしない。本番 (Amazon RDS) の認証情報は使用しない。
#
# docker compose (db / backend / backend-init / Dev Container の app) が .env を env_file として読み込む。

# PostgreSQL の接続情報。db コンテナの初期化とバックエンドの接続に使う。
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB は DB ボリュームの作成時にだけ反映される。
# 変更したときは `docker compose down -v` でボリュームを削除して作り直す。
# データベース名は大文字小文字を区別する。
POSTGRES_USER=idb
POSTGRES_PASSWORD=change_me
POSTGRES_DB=IDB
